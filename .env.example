# Qloo hackathon key (X-Api-Key). Base URL is https://hackathon.api.qloo.com. Never commit the real value.
QLOO_API_KEY=
# Set to 1 to use synthetic fixtures instead of the live Qloo API.
QLOO_MOCK=1
# Anthropic key for the agent loop.
ANTHROPIC_API_KEY=
# Optional extra model call for a matched-brief comparison. No measured quality advantage is implied.
SOUNDCHECK_WITHOUT_QLOO=0
# Per-instance custom-plan limits, shared by visitors. Saved plans remain readable.
SOUNDCHECK_PLAN_CONCURRENCY=2
SOUNDCHECK_PLAN_STARTS=20
# Redis for the Qloo cache and saved plans. On Railway, reference the Redis service: REDIS_URL=${{Redis.REDIS_URL}}.
# Leave blank for in-memory + .cache/plans files in dev. (UPSTASH_REDIS_REST_URL/TOKEN also work as a fallback.)
REDIS_URL=


# Optional. Enables DELETE /api/plan/<id> (Authorization: Bearer <token>) to flush a stored plan so a seeded demo regenerates.
SOUNDCHECK_ADMIN_TOKEN=
